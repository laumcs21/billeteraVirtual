<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Pane?>

<Pane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.edu.poo.billetera_controller.UsuariosConMasTransaccionesGraficaController">
   <children>
      <BarChart fx:id="usuariosBarChart" layoutX="50.0" layoutY="50.0" prefHeight="300.0" prefWidth="500.0">
         <xAxis>
            <CategoryAxis fx:id="xAxis" label="Usuario" />
         </xAxis>
         <yAxis>
            <NumberAxis fx:id="yAxis" label="Cantidad de Transacciones" lowerBound="0" upperBound="30" tickUnit="5" />
         </yAxis>
      </BarChart>
      <Button fx:id="volverButton" layoutX="500.0" layoutY="370.0" mnemonicParsing="false" onAction="#volver" text="Volver" />
   </children>
</Pane>
