<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.Pane?>

<Pane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.edu.poo.billetera_controller.UsuariosConMasTransaccionesController">
   <children>
      <TableView fx:id="usuariosTable" layoutX="50.0" layoutY="50.0" prefHeight="250.0" prefWidth="500.0">
        <columns>
          <TableColumn fx:id="usuarioColumn" prefWidth="250.0" text="Usuario" />
          <TableColumn fx:id="transaccionesColumn" prefWidth="250.0" text="Cantidad de Transacciones" />
        </columns>
      </TableView>
      
      <Button fx:id="verGraficaButton" layoutX="150.0" layoutY="320.0" mnemonicParsing="false" onAction="#verGrafica" text="Ver Gráfica" />
      <Button fx:id="volverButton" layoutX="300.0" layoutY="320.0" mnemonicParsing="false" onAction="#volver" text="Volver" />
   </children>
</Pane>
