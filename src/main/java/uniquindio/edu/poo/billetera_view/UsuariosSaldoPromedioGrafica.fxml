      <BarChart fx:id="usuariosBarChart" layoutX="50.0" layoutY="50.0" prefHeight="300.0" prefWidth="500.0">
        <xAxis>
          <CategoryAxis fx:id="xAxis" label="Usuario" />
        </xAxis>
        <yAxis>
          <NumberAxis fx:id="yAxis" label="Saldo" />
        </yAxis>
      </BarChart>
      <Button fx:id="volverButton" layoutX="500.0" layoutY="360.0" mnemonicParsing="false" onAction="#volver" text="Volver" />
   </children>
</Pane>
